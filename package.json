{
  "name": "web-profile",
  "version": "0.1.8",
  "description": "本机前端项目桌面启动器",
  "type": "module",
  "scripts": {
    "web": "vite",
    "tauri": "node scripts/run-tauri.mjs",
    "dev": "npm run tauri -- dev",
    "dev:renderer": "vite",
    "dev:renderer:tauri": "vite",
    "dev:tauri": "npm run dev",
    "prebuild": "node scripts/bump-version.mjs",
    "build": "npm run tauri -- build",
    "build:renderer": "vite build",
    "build:tauri": "npm run build",
    "prebuild:portable": "node scripts/bump-version.mjs",
    "build:portable": "node scripts/build-tauri-portable.mjs",
    "build:portable:desktop": "npm run build:portable && node scripts/create-portable-shortcut.mjs",
    "build:portable:tauri": "npm run build:portable",
    "dist:tauri": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-tauri-portable.ps1",
    "start": "npm run dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "tauri",
    "project-launcher",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
