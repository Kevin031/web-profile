{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Profile",
  "version": "0.1.10",
  "identifier": "com.webprofile.app",
  "build": {
    "beforeDevCommand": "npm run dev:renderer:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "前端项目启动器",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RDVBNEI2NzQ5MTg1MApSV1JRR0VsblMxcHRCZEc1NWQ0azZYWThMeXdmdXpTWFhkRnI3SWxYNk9BTDY0U2QwQUdsUWdnZwo=",
      "endpoints": [
        "https://github.com/Kevin031/web-profile/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
